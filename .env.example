# Google Analytics 4 (Admin → Analytics)
# Numeric GA4 property ID (Admin → Property details), not the G-XXXX measurement ID.
ANALYTICS_PROPERTY_ID=
# Google service account JSON key. Keep it outside public/ and out of Git.
# Default: storage/app/analytics/service-account-credentials.json
ANALYTICS_CREDENTIALS_PATH=
# Minutes a dashboard report is cached before GA4 is queried again.
ANALYTICS_CACHE_MINUTES=30
